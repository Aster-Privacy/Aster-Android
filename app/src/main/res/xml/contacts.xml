        </DataKind>
        <DataKind kind="relationship">
            <Type type="assistant" />
            <Type type="brother" />
            <Type type="child" />
            <Type type="father" />
            <Type type="friend" />
            <Type type="manager" />
            <Type type="mother" />
            <Type type="parent" />
            <Type type="partner" />
            <Type type="relative" />
            <Type type="sister" />
            <Type type="spouse" />
            <Type type="custom" />
        </DataKind>
        <DataKind kind="note" maxOccurs="1" />
