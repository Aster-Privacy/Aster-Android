    <string name="recovery_reminder_title">أضف بريدًا للاسترداد</string>
    <string name="recovery_reminder_body">يتيح لك بريد الاسترداد استعادة حسابك إذا نسيت كلمة السر.</string>
    <string name="recovery_reminder_action">إضافة بريد الاسترداد</string>
